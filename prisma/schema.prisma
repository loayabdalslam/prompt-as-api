generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ApiRecord {
  id        String   @id @default(cuid())
  namespace String
  key       String
  valueJson String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([namespace, key])
  @@index([namespace])
}

model AuditLog {
  id          String   @id @default(cuid())
  requestId   String
  provider    String
  model       String
  endpoint    String?
  statusCode  Int
  inputJson   String
  outputJson  String
  toolCalls   String
  createdAt   DateTime @default(now())

  @@index([requestId])
  @@index([endpoint])
}

model DailyTestRun {
  id          String   @id @default(cuid())
  suiteName   String
  status      String
  total       Int
  passed      Int
  failed      Int
  resultsJson String
  createdAt   DateTime @default(now())
}
